(defun string-match-get (regexp string num)
  (save-match-data
    (when (string-match regexp string)
      (match-string-no-properties num string))))

(defvar sxv8-jd-base-file "c:/Users/26289/Asiainfo/陕西V8/信管环境搭建/create-jd-base-tables.sql")
(defvar sxv8-create-jd-all-sub-file "c:/Users/26289/Asiainfo/陕西V8/信管环境搭建/create-jd-all-sub-tables.sql")
(defvar sxv8-drop-jd-all-sub-file "c:/Users/26289/Asiainfo/陕西V8/信管环境搭建/drop-jd-all-sub-tables.sql")

(defun sxv8-get-jd-base-tables ()
  (let* ((string (file-contents sxv8-jd-base-file))
         (lst (split-block string "^create table.+")))
    (mapcar (lambda (base-sql)
              (string-match-get "create table JD\\.\\(.+\\)*$" base-sql 1))
            lst)))

