(require 'zkutil)

(defun split-block (string regexp)
  (let ((start 0)
        result)
    (while (string-match regexp string start)
      (let* ((lst (match-data 0))
             (beg (nth 0 lst))
             (end (nth 1 lst))
             block)
        (if (string-match regexp string end)
            (setq end (1- (nth 0 (match-data 0))))
          (setq end (length string)))
        (setq block (substring string beg end))
        (setq result (append result (list block)))
        (setq start end)))
    result))

(defun rewrite-to-file (file string)
  (with-current-buffer (find-file-noselect file)
    (erase-buffer)
    (insert string)
    (save-buffer)))

