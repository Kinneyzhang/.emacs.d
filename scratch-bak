(defun sxv8-create-all-jd-tables-by-base ()
  (let* ((base-file sxv8-jd-base-file)
         (res-create-file sxv8-create-jd-all-sub-file)
         (res-drop-file sxv8-drop-jd-all-sub-file)
         (string (file-contents base-file))
         (lst (split-block string "^create table.+"))
         (suffix-seq (seq-map #'zk/num-to-str (number-sequence 1 12)))
         base-table-name table-name
         create-sqls drop-sqls)
    (dolist (base-sql lst)
      (setq base-table-name (string-match-get "create table JD\\.\\(.+\\) (.*$" base-sql 1))
      (when base-table-name
        (dolist (month suffix-seq)
          (setq table-name (concat base-table-name "_" month))
          (setq create-sqls
                (concat create-sqls (replace-regexp-in-string
                                     (regexp-quote base-table-name) table-name base-sql t)
                        "\n"))
          (setq drop-sqls
                (concat drop-sqls (format "drop table jd.%s cascade constraints;" table-name) "\n")))))
    (rewrite-to-file res-create-file create-sqls)
    (rewrite-to-file res-drop-file drop-sqls)))

(sxv8-create-all-jd-tables-by-base)